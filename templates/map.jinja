{% extends "layout.jinja" %}
{% block title %} Map {% endblock %}
{% block more_css %} 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" /> <!-- star rating thingy --> 
    <!-- NB! My actual 'index.js' map JS is execute here: -->
    <script type="module" src=" {{ url_for ('static', filename='index.js') }}"></script>            
    <!-- Above, I load 'index.js' to be run. It has all the actual logic for the map. I thought it might be a bit faster to load this big js below the actual map script above, but it doesn't seem to matter regarding the loading time of the page for the user. -->
{% endblock %}
{% block content %}

    <div id="map-search-name"> <!-- for searching restaurants above in the map -->
        <h3> filter by name </h3>
        <input name="search-query" oninput="mapSearch(event)" placeholder="search the map">        <!-- oninput = every time the user types; onchange is activated every time you push enter -->
        <script>
            const mapSearch = event => {
                const query = event.currentTarget.value.toLowerCase() // if the search box says 'thai', then query = 'thai'
                const markerContainers = document.querySelectorAll('#map .marker-container') // I have set id = 'marker-container' for every marker container in 'index.js' - using this, I can hide/show each of them. Note: why two #? This is hierarchichal; the first one (#map) is the highest-level (parent) element to search for (with id map), and from all its children elements, the second search term (#marker-container) is used
                markerContainers.forEach(markerContainer => {
                    markerContainer.querySelectorAll('.label-element').forEach(labelElement => {
                        if (query.length>50) {
                            alert("The query must be 50 characters or under")
                        } else if (query !== '') {
                            if (labelElement.textContent.toLowerCase().includes(query)) {
                                markerContainer.style.display = 'flex'      // display !== 'none' means that it's NOT hidden. Learned this on a JS course
                            } else {
                                markerContainer.style.display = 'none'      // display = 'none' hides the element
                            }
                        } else {
                            markerContainer.style.display = 'flex'          // if the query is 'flex' (original) then show all markers!
                        }
                    })
                })
            }           
        </script>
    </div>

    <div id="map-search-descriptions"> <!-- for searching restaurants above in the map -->
        <h3> filter by descriptions </h3>
        <input name="search-query" oninput="descriptionsSearch(event)" placeholder="search the map">        <!-- oninput = every time the user types -->
        <script>
            const descriptionsSearch = event => {
                const query = event.currentTarget.value.toLowerCase() // if the search box says 'thai', then query = 'thai'
                const markerContainers = document.querySelectorAll('#map .marker-container') // I have set class = 'marker-container' for every marker container in 'index.js' - using this, I can hide/show each of them. Note: why two #? This is hierarchichal; the first one (#map) is the highest-level (parent) element to search for (with id map), and from all its children elements, the second search term (.marker-container) is used
                // console.log("markerContainers:", markerContainers)
                markerContainers.forEach(markerContainer => {
                    markerContainer.querySelectorAll('.label-element').forEach(labelElement => {    
                        if (query.length>50) {
                            alert("The query must be 50 characters or under")
                        } else if (query !== '') {
                            for (let i = 0; i < labelElement.descriptions.length; i++) {            // I just learned that 'break;' is not possible for .forEach, so I have to use a normal loop instead
                                if (labelElement.descriptions[i].toLowerCase().includes(query)) {
                                    markerContainer.style.display = 'flex'      // display !== 'none' means that it's NOT hidden. Learned this on a JS course
                                    break;                                      // if a description is found, then show the marker and stop looking
                                } else {
                                    markerContainer.style.display = 'none'      // display = 'none' hides the element
                                }
                            }
                        } else {
                            markerContainer.style.display = 'flex'          // if the query is 'flex' (original) then show all markers!
                        }
                    })
                })
            }           
        </script>
    </div>
    
    <!--MAP. Do not change the id (was given by default in the google instructions pages). -->
    <div id="map"></div>                <!-- height 100% etc, see style.css. NB! You CAN NOT change the name of this id, or the map (from index.js) will not load into this div at all! (see index.js 'map = new Map(document.getElementById("map")') -->

    <div id="search-function"> <!-- This search is for querying the restaurant list BELOW, not for searching restaurants above in the map.-->
        <h2> search </h2>
        <p> name search for the list below </p>
        <input name="search-query" oninput="search(event)">
    
        <script>
            const search = event => {
                const query = event.currentTarget.value.toLowerCase()
                
                const restaurantDiv = document.querySelectorAll('.restaurant-div-element') // each of these (see below) has <h3> and <ul> with 2 <li>s
                restaurantDiv.forEach(infoElement => {
                    infoElement.querySelectorAll('h3').forEach(header => {
                        if (query.length>50) {
                            alert("The query must be 50 characters or under")
                        } else if (query !== '') {
                            if (header.textContent.toLowerCase().includes(query)) {
                                infoElement.style.display = ''      // display = '' means that it's NOT hidden. Learned this on a JS course
                            } else {
                                infoElement.style.display = 'none'  // display = 'none' hides the element
                            }
                        } else {
                            infoElement.style.display = ''
                        }
                        
                    })
                })
            }           
        </script>
    </div>
    
    <div id="ranked-restaurants">
        <h2> Establishments (highest ranking first) </h2>
        <ul>          
            <script type="module">

                import apiServices from '../static/apiServices.js'
                import indexJS from '../static/index.js'            // I'm trying to recenter it
                const map = indexJS.map
                const lngLatJSON = indexJS.lngLatJSON
                const descriptions = indexJS.exportedDescriptions
                console.log('descriptions:', descriptions)          // { restaurant_id : [description1, description2, ...]}
                console.log('Object keys(descriptions):', Object.keys(descriptions));                
                console.log('lngLatJSON:', lngLatJSON)
                //console.log('map:', map)                          // map: Object { gm_bindings_: {…}, Fg: {…}, __gm: {…}, gm_accessors_: {…}, mapCapabilities: {…}, renderingType: "RASTER", zoom: 15, center: {…}, mapId: "DINER_MAP_1", mapTypeId: "roadmap", … }
                //console.log('map.center:', map.center)            // turned out not to be useful: map.center: Object { lat: lat(), lng: lng() } // so it gives two functions, not anything I can change!
                //console.log('lngLatJSON:', lngLatJSON)

                const placeId_placeInfo = []                        // array of JSONs: [ {id: {...}}, ... ]. Each JSON shall have properties 'id', 'name', 'average', 'nRatings' and 'average' (nRatings = number of ratings)

                let infoHTML = document.createElement('ul')         // this infoHTML will be added to on every loop of .map below
                infoHTML.id = 'infoHTML'
                const restaurants = {{ restaurants | tojson }}      // if this shows red (linting error): install "betterJinja" from Extensions (in VSCode). That gets rid of the red underlining. However, then you have to rename .html files as .jinja. Or somehow fix that.
                //console.log('restaurants:', restaurants)          // restaurants: [{"address": "Hämeentie 153, 00560 Helsinki", "id": 1, "restaurant_name": "Krung Thep Thai Bistro Arabia", "restaurant_visible": true}, {"address": "Koskelantie 56, 00610 Helsinki", "id": 2, "restaurant_name": "Thai Ravintola Meelom Oy", "restaurant_visible": true}, {"address": "laurintie vantaa", "id": 3, "restaurant_name": "pizzeria toli", "restaurant_visible": true}, {"address": "ilola", "id": 4, "restaurant_name": "hesburger ilola", "restaurant_visible": true}, {"address": "kumpula", "id": 9, "restaurant_name": "kaljaravintola oljenkorsi", "restaurant_visible": true}, {"address": "kumpula", "id": 10, "restaurant_name": "ravintola nyyrikki", "restaurant_visible": true}, {"address": "kumpula", "id": 11, "restaurant_name": "ravintola nyyrikki", "restaurant_visible": true}, {"address": "kumpula", "id": 12, "restaurant_name": "iso paja", "restaurant_visible": true}]

                const promises = restaurants.map(async restaurant => {  // all these Promises, [{...}, {...}, ...}] (because 'async'!) are functions, {...}; this .map gathers them inside a list.

                    const filteredRatings = await apiServices.getAll(`/api/ratings/${restaurant.id}?only_visible_ratings=1`) // because the function is async, I have to 'await' for it to finish. Without await, you'd get a 'promise' instead - doesn't work!
                    const ratingAverage = filteredRatings.reduce((sum, current) => current.rating + sum, 0)/filteredRatings.length
                    const restaurantId_info = {
                        'restaurant_id' : restaurant.id,
                        'restaurant_name' : restaurant.restaurant_name,
                        'address' : restaurant.address,
                        'nRatings' : filteredRatings.length,
                        'average' : filteredRatings[0] ? ratingAverage : 0 // if the average was calculated (not NaN, if /0), then use that. Otherwise the value shall be 0, so that the following sorting works (NaNs will mess up .sort of JS)
                    }           // id, name, average, nRatings
                    placeId_placeInfo.push(restaurantId_info)
                })

                // console.log("promises:", promises) // you'll see 8 Promises with 'undefined' status; proving, they are not FULFILLED at this point yet
                // if you don't wait for all the promises above to be fulfilled (it's async!), then the placeId_placeInfo will be empty, and no sorting will happen. This was kindly reminded me by ChatGPT. A JavaScript course: "Promise.all returns a Promise that fulfills when all the promises it receives have been fulfilled. It rejects when one of these promises fails. This allows you to execute more than one promise at the same time and wait until all of them have fulfilled."
                await Promise.all(promises) 

                placeId_placeInfo.sort((a, b) => {
                    // console.log({a,b})               // for each item in the list, this shows all the pairs that are compared. JS is smart about the comparisons; for example, if the whole list is in order, it will only compare each adjacent pair once, and so on - so it cuts down unnecessary work
                    return b.average - a.average})      // sort of JS: (a,b) => if negative, then a comes before b. So, I'm sorting based on the vote average

                //console.log('placeId_placeInfo:', placeId_placeInfo)

                placeId_placeInfo.forEach(restaurantJSON => {
                    const restaurantDivElement = document.createElement('div')
                    restaurantDivElement.classList.add('restaurant-div-element')

                    const nameElement           =   document.createElement('h3')
                    const mapFocusButton        =   document.createElement('button')
                    const restaurantUlElement   =   document.createElement('ul')
                    const averageElement        =       document.createElement('li')
                    const addressElement        =       document.createElement('li')
                    const descriptionsUl        =       document.createElement('ul')

                    averageElement.classList.add('average-element') // for the search function way above
                    addressElement.classList.add('address-element')

                    // innerHTML would be usable as well, but that would enable script injection - textContent in JS is safe, since even if you write <script> there, it won't be interpreted as JS. So I could use '.innerHTML = safeHTML(text_here)' or .textContent = text_here directly. I didn't have that opportunity (.textContent) in 'index.js' since I was using ad-hoc React (not the real deal, a poor man's version)
                    nameElement.textContent = restaurantJSON.restaurant_name
                    mapFocusButton.textContent = 'show on map'
                    averageElement.textContent = restaurantJSON.nRatings === 0 
                        ? '0 ratings'
                        : `average ${Math.round(restaurantJSON.average*100)/100} (${restaurantJSON.nRatings} rating${restaurantJSON.nRatings === 1 ? '' : 's'})`
                    addressElement.textContent = restaurantJSON.address

                    const d = descriptions[restaurantJSON.restaurant_id]
                    console.log("restaurantJSON.restaurant_id:", restaurantJSON.restaurant_id)
                    console.log("descriptions[4]:", descriptions[4])
                    console.log("descriptions['4']:", descriptions['4'])
                    //console.log("descriptions.4:", descriptions.4)
                    console.log("d:", d)

                    // COMMENTOUT
                    {# d.forEach(description => {
                        const li = document.createElement('li')
                        li.textContent = description
                        descriptionsUl.appendChild(li)
                    }) #}

                    restaurantDivElement.appendChild(nameElement)
                    restaurantDivElement.appendChild(restaurantUlElement)
                    restaurantDivElement.appendChild(mapFocusButton)
                    restaurantUlElement.appendChild(averageElement)
                    restaurantUlElement.appendChild(addressElement)
                    restaurantUlElement.appendChild(descriptionsUl)

                    // no XSS risk here, as everything is "textContent" instead of innerHTML. ALSO; I could use static/safeHTML.js here, but I already wrote all this code before coming up with the safeHTML function, so...
                    infoHTML.appendChild(restaurantDivElement)
                    mapFocusButton.addEventListener('click', () => {
                        const LongLat = lngLatJSON[restaurantJSON.restaurant_id]            // { lng, lat }
                        const name = restaurantJSON.restaurant_name
                        console.log('clicked, restaurantJSON:', restaurantJSON)
                        console.log('LongLat:', LongLat)
                        map.setCenter({ lat : LongLat.lat, lng: LongLat.lng })
                        document.getElementById('map').scrollIntoView({ behavior: 'smooth' })
                        const labels = document.querySelectorAll('span.label-element')
                        labels.forEach(label => {
                            if (label.textContent === name) {
                                label.style.backgroundColor = 'yellow'
                            } else {
                                label.style.backgroundColor = 'white'
                            }
                        })
                    })

                    // the restaurantHTML below, without the `` that converts it to string, returns a <div>, so that I can actually appendChild(<div>...</div>) here! I have to convert it to string so I can
                })
                document.querySelector('#ranked-restaurants').appendChild(infoHTML) // this just adds the infoHTML <ul> with all the <li>'s (restaurants in order) to the end of the <body> of this HTML
            </script>
        </ul>
    </div>
    
    <!-- prettier-ignore -->
    <!-- NB! This below is copy-pasted from Google Places API instructions - no idea what all the things here do! This is needed for the map, obviously. -->
    <script>(g=>{
        var h,a,k,p="The Google Maps JavaScript API",
        c="google",
        l="importLibrary",
        q="__ib__",
        m=document,
        b=window;
        b=b[c]||(b[c]={});
        var d=b.maps||(b.maps={}),
        r=new Set,e=new URLSearchParams,
        u=()=>h||(h=new Promise(async(f,n)=>{
            await (a=m.createElement("script"));
            e.set("libraries",[...r]+"");
            for(k in g)e.set(k.replace(/[A-Z]/g,t=>"_"+t[0].toLowerCase()),
            g[k]);
            e.set("callback",c+".maps."+q);
            a.src=`https://maps.${c}apis.com/maps/api/js?`+e; // note! This had previously failed due to "CORS same origin policy" in some cases with uBlocker active. Doesn't fail anymore as far as I can recall.
            d[q]=f;
            a.onerror=()=>h=n(Error(p+" could not load."));
            a.nonce=m.querySelector("script[nonce]")?.nonce||"";
            m.head.append(a)
        }));
        d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))
    })
        ({key: "{{ key }}", v: "weekly"});
    </script> <!-- note the "{{ key }} above!"; this is normal Jinja syntax to pass the Google Cloud API key passed here from app.py (through the render_template). -->
    
    

{% endblock %}